---
import '../styles/reset.css';
import '../styles/bitacora.css';
import '../styles/interior.css';
import '../styles/miniaturas.css';
import '../styles/ajustes.css';
import Top from '../components/Top.astro';
import Foot from '../components/Foot.astro';
import Search from '../components/Search.astro';
const { title, description, canonical = 'https://wlaque.cl/', ogTitle = title, ogDescription = description, active = '' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website"><meta property="og:site_name" content="wlaque.cl"><meta property="og:locale" content="es_CL">
<meta property="og:title" content={ogTitle}><meta property="og:description" content={ogDescription}><meta property="og:url" content={canonical}><meta property="og:image" content="https://wlaque.cl/og.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#1b1e14">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="wlaque.cl" href="/rss.xml">
<slot name="head" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=JetBrains+Mono:wght@500;700;800&family=VT323&display=swap" rel="stylesheet">
</head>
<body>
<div class="shell"><Top active={active} /><slot /><Foot /></div>
<Search />
</body>
</html>
