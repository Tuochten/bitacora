---
import Base from '../layouts/Base.astro';
import '../styles/prosa.css';
import Row from '../components/Row.astro';
import site from '../data/site.json';
import { byDate } from '../lib/sitio.js';

const title = "Desarrollo web freelance — Webflow y Shopify | wlaque.cl";
const description = "Sitios en Webflow y tiendas en Shopify con dominio, DNS y correo bien configurados. Más de 150 proyectos web. También rescates y migraciones de WordPress.";
const jsonLD = {"@context":"https://schema.org","@type":"ProfessionalService","name":"Desarrollo web — wlaque.cl","url":"https://wlaque.cl/desarrollo-web/","provider":{"@type":"Person","name":"Wladimir Aqueveque H."},"serviceType":["Webflow","Shopify","Migración de WordPress"]};

const webdev = site.webdev;
const posts = byDate(site.posts);
const webflowDevPosts = posts.filter((p) => p.type === 'entrada' && (p.category === 'Webflow' || p.category === 'Dev')).slice(0, 3);
---

<Base active="web" title={title} description={description} canonical="https://wlaque.cl/desarrollo-web/">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLD)} />
  <main id="contenido">
    <header class="phead">
      <nav aria-label="Ruta" class="crumbs"><a href="/">Inicio</a><span aria-hidden="true">›</span><span aria-current="page">Desarrollo web</span></nav>
      <h1 class="cursor">Desarrollo web</h1>
      <p class="lede" id="lede">{webdev.lede}</p>
    </header>
    <div class="grid">
      <div class="col">
        <section aria-labelledby="h-que">
          <div class="sec"><h2 id="h-que">Qué hago</h2><span class="r"></span></div>
          <div class="units three" id="services">
            {webdev.services.map((s) => (
              <div class="unit">
                <div class="unit-top"><span class={s.tier === 'principal' ? 'unit-state' : 'unit-state w'}><i aria-hidden="true"></i>{s.platform}</span><span class="unit-year">{s.tier}</span></div>
                <h3>{s.title}</h3>
                <p>{s.description}</p>
                <div class="st">{s.includes}</div>
              </div>
            ))}
          </div>
        </section>
        <section aria-labelledby="h-como" class="sec-gap">
          <div class="sec"><h2 id="h-como">Cómo trabajo</h2><span class="r"></span></div>
          <ol class="steps" id="steps">
            {webdev.steps.map((s, i) => (
              <li><span class="n">{String(i + 1).padStart(2, '0')}</span><b>{s.title}</b><span>{s.text}</span></li>
            ))}
          </ol>
        </section>
        <section aria-labelledby="h-incl" class="sec-gap">
          <div class="sec"><h2 id="h-incl">Incluido en todos los proyectos</h2><span class="r"></span></div>
          <ul class="incl" id="incl">
            {webdev.included.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </section>
        <section aria-labelledby="h-esc" class="sec-gap">
          <div class="sec"><h2 id="h-esc">Lo he escrito</h2><span class="r"></span><a href="/blog/">Ver blog →</a></div>
          <div class="log" id="log">
            {webflowDevPosts.map((p) => (
              <Row post={p} />
            ))}
          </div>
        </section>
        <div class="cta">
          <div><b>¿Tienes un proyecto?</b>
            <p id="cta-p">Cuéntame qué necesitas y te respondo en {webdev.response}.</p></div>
          <a class="btn" href="/contacto/">Contáctame →</a>
        </div>
      </div>
      <aside aria-label="Resumen">
        <div class="sticky">
          <div class="stat" id="stat">{site.profile.freelance.projects}</div>
          <div class="stat-l" id="stat-l">{site.profile.freelance.projectsLabel}</div>
          <h2 class="side-h">Plataformas</h2>
          <ul>
            <li class="pri">Webflow</li>
            <li class="pri">Shopify</li>
            <li>WordPress (rescates y migraciones)</li>
          </ul>
          <h2 class="side-h">Detalles</h2>
          <dl class="facts" id="facts">
            <dt>Respuesta</dt>
            <dd>{webdev.response}</dd>
            <dt>Contacto</dt>
            <dd><a href="/contacto/">Formulario</a></dd>
          </dl>
        </div>
      </aside>
    </div>
  </main>
</Base>
